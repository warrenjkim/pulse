common --announce_rc
common --color=yes
common --curses=yes
common --check_direct_dependencies=warning
common --enable_platform_specific_config

build --incompatible_strict_action_env
build --features=layering_check
build --cxxopt=-std=gnu++23
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic
build --cxxopt=-Wconversion
build --cxxopt=-Wsign-conversion
build --cxxopt=-Wcast-align
build --cxxopt=-Wcast-qual
build --cxxopt=-Wformat=2
build --cxxopt=-Winit-self
build --cxxopt=-Wmissing-declarations
build --cxxopt=-Woverloaded-virtual
build --cxxopt=-Wredundant-decls
build --cxxopt=-Wundef

build:macos --copt=-mmacosx-version-min=26.0
build:macos --linkopt=-mmacosx-version-min=26.0

build:asan --features=asan
build:asan --cxxopt=-DADDRESS_SANITIZER

build:ubsan --features=ubsan
build:ubsan --cxxopt=-DUNDEFINED_BEHAVIOR_SANITIZER

build:strict --config=asan
build:strict --cxxopt=-Werror
build:strict --cxxopt=-O1
build:strict --cxxopt=-g
build:strict --cxxopt=-fno-omit-frame-pointer
build:strict --strip=never

test --test_output=all
test --test_arg=--gtest_color=yes
